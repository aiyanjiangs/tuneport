{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunePort",
  "version": "1.0.0",
  "identifier": "com.tuneport.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "ncm 音频转换工具",
    "longDescription": "把加密的 .ncm 音频还原成 mp3/flac,并写入歌名、歌手、专辑标签。全程本地处理。",
    "category": "Utility",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
